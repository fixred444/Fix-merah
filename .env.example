# Dari Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi_anon_key
SUPABASE_SERVICE_ROLE_KEY=isi_service_role_key

# Kunci enkripsi app password: 64 karakter hex (buat dengan: openssl rand -hex 32)
ENCRYPT_KEY=

# Email admin (pisahkan koma kalau lebih dari satu). Akun ini otomatis jadi admin saat daftar.
ADMIN_EMAILS=emailkamu@gmail.com

# Batas wajar kirim per hari (zona WIB)
DAILY_LIMIT=10
PER_NUMBER_LIMIT=3

# Batas pengiriman harian untuk setiap akun yang ikut Sender Global
PER_SENDER_DAILY_LIMIT=10

# Notifikasi sistem (Web Push). Buat sepasang kunci dengan: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:emailkamu@gmail.com
